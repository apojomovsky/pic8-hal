# Build outputs
build*/
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.out

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Python bytecode cache (scripts/ci-discover-*.py are run directly with
# python3, no venv/install step, so a stray __pycache__/ can appear next
# to them on any local run)
__pycache__/
*.pyc

# Claude Code local state (personal settings, session/lock files)
.claude/

# CMake (generated only — build*/ above already covers the generated
# top-level Makefile CMake emits in a build dir; a bare "Makefile" rule here
# would also match hand-written source Makefiles like mcu/*/Makefile, which
# are real, tracked files, not build output)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Vendor datasheets / app notes — not committed (copyrighted Microchip
# documentation); docs link to Microchip's own hosted PDFs instead.
*.pdf

# Vendor installers (e.g. a manually-downloaded XC8 .run, see
# docker/ci-toolchain/Dockerfile): large binaries, never meant to be
# committed, only ever a local, temporary staging step.
*.run

# docker/ci-toolchain/vendor/: populated at build time only (extracted
# from a private GHCR asset image, see .github/workflows/xc8-build.yml),
# holds whatever vendor installer file type shows up there (.run, .tar,
# ...); ignore the whole directory rather than chasing extensions one at
# a time, *.run above already missed the .tar MPLAB X IDE installer once.
docker/ci-toolchain/vendor/

# Release bundles are build output, never committed.
bundles/

# Reference MPLAB X projects' build output (build*/ above already
# catches build/, dist/ is MPLAB X's own separate output dir).
/examples/*/dist/

# CI's ci.yml target job: manifest-resolved build matrix and per-step
# PASS/FAIL summaries, all repo-root-relative build output.
/matrix.txt
/ci-summary-*.md
